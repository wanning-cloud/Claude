{
  "name": "monteur-podcast/cockpit-api",
  "description": "Podcast-Cockpit API (PHP 8, SQLite) for all-inkl shared hosting",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2",
    "ext-pdo_sqlite": "*",
    "ext-curl": "*",
    "ext-openssl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-simplexml": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.4"
  },
  "autoload": { "psr-4": { "Cockpit\\": "src/" } },
  "autoload-dev": { "psr-4": { "Cockpit\\Tests\\": "tests/" } },
  "scripts": { "test": "phpunit --colors=never" },
  "config": { "sort-packages": true, "platform": { "php": "8.3.0" } }
}
