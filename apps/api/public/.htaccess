# Podcast-Cockpit API (all-inkl, Apache). Everything goes to index.php.
Options -Indexes
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [QSA,L]
</IfModule>
<FilesMatch "^(\.|.*\.(sqlite|env|json|sql|md|lock)$)">
  Require all denied
</FilesMatch>
