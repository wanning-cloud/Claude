# Podcast-Cockpit – Einstellungen. Echte Datei: analytics.env AUSSERHALB des Web-Ordners auf dem Server.
# Pfad zur Datei steht in podcast-admin/analytics/api/app/env-path.txt. Nie ins Repo, nie in den Chat.

APP_ENV=prod

# Datenbank und Sicherungen (außerhalb des Web-Ordners)
DATABASE_PATH=/pfad/ausserhalb/webroot/analytics-private/cockpit.sqlite
BACKUP_DIR=/pfad/ausserhalb/webroot/analytics-private/backups

# Sicherheit (je 32+ Zeichen zufällig, z. B. `openssl rand -base64 32`)
ENCRYPTION_KEY=
ADMIN_TOKEN_SECRET=
CRON_KEY=

# Anmeldung über die Sitzung des podcast-admin (Standardwerte passen zum Upload-Helfer)
ADMIN_SESSION_NAME=mp_admin
ADMIN_SESSION_KEY=ok
ADMIN_LOGIN_URL=/podcast-admin/
ADMIN_URL=/podcast-admin/
PUBLIC_ORIGIN=https://monteur-podcast.de

# Quellen
FEED_URL=https://monteur-podcast.de/feed.xml
YT_CHANNEL_ID=UChfzQnxKs6On8gsVByAPZRw
APPLE_PODCAST_ID=6819469570
APPLE_STOREFRONTS=de,at,ch

# YouTube (Google-Cloud-Projekt, OAuth-Client „Webanwendung“)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://monteur-podcast.de/podcast-admin/analytics/api/youtube/callback

# Download-Messung Variante A: Ordner mit den Roh-Zugriffslogs von all-inkl
ACCESS_LOG_DIR=
ACCESS_LOG_GLOB=access*log*

# Variante B (nur falls A nicht geht)
OP3_TOKEN=
OP3_SHOW_UUID=

# Stufe 2/3
ROUTINE_FIRE_URL=
ROUTINE_FIRE_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
SMTP_HOST=
IMAP_HOST=
